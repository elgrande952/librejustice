                    "INFIRMATION",
                    "INFIRMATION_PARTIELLE",
                    "REFORMATION",
                    "CASSATION",
                    "CASSATION_PARTIELLE",
                    "ANNULATION",
                    "CONFORMITE",
                    "NON_CONFORMITE",
                    "INELIGIBILITE",
