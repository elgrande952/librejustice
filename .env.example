# Copier en `.env` (chargé par mise) et compléter. Aucune valeur réelle ici.
# L'exploitation (tokens d'admin, bancs) vit dans `.env.admin`, hors de ce miroir.

# --- Cloudflare ---
LIBREJUSTICE_CLOUDFLARE_ACCOUNT_ID=
LIBREJUSTICE_CLOUDFLARE_BACKEND_TOKEN=change_me

# --- Postgres ---
LIBREJUSTICE_PG_PASSWORD=change_me

# --- Runtime ---
LIBREJUSTICE_STATE_DIR=${HOME}/.local/share/librejustice
LIBREJUSTICE_API_DEPLOYMENT_ENVIRONMENT=dev
LIBREJUSTICE_API_DB_APPLICATION_NAME=
LIBREJUSTICE_DB_URL=postgresql://librejustice@127.0.0.1:5432/librejustice
LIBREJUSTICE_API_BIND_PORT=8300

# --- Supabase ---
LIBREJUSTICE_API_SUPABASE_SECRET_KEY=change_me
LIBREJUSTICE_VITE_SUPABASE_URL=
LIBREJUSTICE_VITE_SUPABASE_PUBLISHABLE_KEY=change_me

# --- Grafana ---
LIBREJUSTICE_GRAFANA_OTLP_USER=
LIBREJUSTICE_GRAFANA_CLOUD_API_KEY=change_me
LIBREJUSTICE_GRAFANA_OTLP_ENDPOINT=

# --- Sources ---
LIBREJUSTICE_PISTE_CLIENT_ID=
LIBREJUSTICE_PISTE_CLIENT_SECRET=change_me

# --- Embeddings ---
LIBREJUSTICE_EMBED_BACKEND=auto
LIBREJUSTICE_EMBED_URL=
LIBREJUSTICE_EMBED_API_KEY=change_me
LIBREJUSTICE_INGEST_NEURON_BUDGET=

# --- LLM ---
LIBREJUSTICE_MISTRAL_API_KEYS=change_me

# --- Web / API ---
LIBREJUSTICE_INDEXNOW_KEY=change_me
LIBREJUSTICE_API_PUBLIC_BASE_URL=http://localhost:8300
LIBREJUSTICE_API_OPENAI_APPS_CHALLENGE_TOKEN=change_me
LIBREJUSTICE_API_GLAMA_MAINTAINER=
LIBREJUSTICE_API_DEEP_PROBE_TOKEN=change_me

# --- Budgets ---
LIBREJUSTICE_API_SEARCH_BUDGET_PER_MIN=
LIBREJUSTICE_API_SEARCH_BUDGET_ENFORCE=
LIBREJUSTICE_API_RERANK_BUDGET_PER_MIN=
