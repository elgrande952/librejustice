# Copier en `.env` (chargé par mise) et compléter. Aucune valeur réelle ici.
# L'exploitation (tokens d'admin, bancs) vit dans `.env.admin`, hors de ce miroir.

# --- Cloudflare ---
LIBREJUSTICE_CLOUDFLARE_ACCOUNT_ID=
LIBREJUSTICE_CLOUDFLARE_BACKEND_TOKEN=change_me

# --- Postgres ---
LIBREJUSTICE_PG_PASSWORD=change_me

# --- Runtime ---
LIBREJUSTICE_STATE_DIR=${HOME}/.local/share/librejustice
LIBREJUSTICE_PG_CONF_DIR=infra/pg-conf
LIBREJUSTICE_API_DB_APPLICATION_NAME=
LIBREJUSTICE_DB_URL=postgresql://librejustice@127.0.0.1:5432/librejustice
LIBREJUSTICE_API_BIND_PORT=8300

# --- Mail transactionnel (Resend) ---
# Clé d'envoi seul, restreinte au domaine vérifié.
LIBREJUSTICE_API_RESEND_API_KEY=re_change_me
LIBREJUSTICE_API_MAIL_FROM="LibreJustice <noreply@librejustice.fr>"

# --- Signalement (relais SMTP) ---
# Adresse ou identifiants vides = signalement désactivé.
LIBREJUSTICE_SMTP_HOST=127.0.0.1
LIBREJUSTICE_SMTP_PORT=587
LIBREJUSTICE_SMTP_USER=
LIBREJUSTICE_SMTP_PASSWORD=change_me
LIBREJUSTICE_API_SUPPORT_MAILBOX=contact@librejustice.fr
LIBREJUSTICE_API_SIGNALEMENTS_PAR_JOUR=200

# --- Google (code flow serveur) ---
# Identifiants OAuth du projet, redirect_uri déclarée côté console Google :
# https://<domaine>/internal/auth/google/callback.
LIBREJUSTICE_GOOGLE_OAUTH_CLIENT_ID=
LIBREJUSTICE_GOOGLE_OAUTH_CLIENT_SECRET=change_me

# Inscription d'app Entra ID multi-tenant (comptes d'organisation + comptes
# Microsoft personnels), redirect_uri https://<domaine>/internal/auth/microsoft/callback,
# claim optionnel `xms_edov` déclaré sur l'id_token.
LIBREJUSTICE_MICROSOFT_OAUTH_CLIENT_ID=
LIBREJUSTICE_MICROSOFT_OAUTH_CLIENT_SECRET=change_me

# --- Grafana ---
LIBREJUSTICE_GRAFANA_OTLP_USER=
LIBREJUSTICE_GRAFANA_CLOUD_API_KEY=change_me
LIBREJUSTICE_GRAFANA_OTLP_ENDPOINT=

# --- Sources ---
LIBREJUSTICE_PISTE_CLIENT_ID=
LIBREJUSTICE_PISTE_CLIENT_SECRET=change_me
LIBREJUSTICE_EGRESS_PROXY=
LIBREJUSTICE_EGRESS_NETWORK=

# --- Embeddings ---
LIBREJUSTICE_EMBED_BACKEND=auto
# Hôtes locaux par ordre de priorité, séparés par des virgules ; la clé de chacun
# à la même position dans LIBREJUSTICE_EMBED_API_KEY, vide pour un hôte sans clé.
LIBREJUSTICE_EMBED_URL=
LIBREJUSTICE_EMBED_API_KEY=change_me
LIBREJUSTICE_INGEST_NEURON_BUDGET=

# --- LLM ---

# --- Web / API ---
LIBREJUSTICE_INDEXNOW_KEY=change_me
LIBREJUSTICE_API_PUBLIC_BASE_URL=http://localhost:8300
LIBREJUSTICE_API_OPENAI_APPS_CHALLENGE_TOKEN=change_me
LIBREJUSTICE_API_GLAMA_MAINTAINER=
LIBREJUSTICE_API_INTERNAL_ORIGIN_TOKEN=change_me
LIBREJUSTICE_API_USAGE_PSEUDONYM_KEY=change_me
# Clé P-256 PKCS#8 DER en base64, une ligne. À générer :
# openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt -outform DER | base64 -w0
LIBREJUSTICE_API_OIDC_SIGNING_KEY=change_me

# --- Budgets ---
LIBREJUSTICE_API_SEARCH_BUDGET_PER_MIN=
LIBREJUSTICE_API_SEARCH_BUDGET_ENFORCE=
LIBREJUSTICE_API_RERANK_BUDGET_PER_MIN=

# Amorce d'un pool vide au premier demarrage, jamais relue ensuite (lj-ingest credential seed).
LIBREJUSTICE_SEED_MISTRAL_KEYS=
LIBREJUSTICE_SEED_GEMINI_KEYS=
