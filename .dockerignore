.git/
.direnv/
node_modules/
**/node_modules/
docs/
*.log

# Le contexte de build est la racine du repo, mais l'image ne copie que les
# artefacts de `mise run build-app` : les deux binaires release et les assets
# SSR. Le reste de `target/` pèse des dizaines de gigaoctets.
target/*
!target/release
target/release/*
!target/release/lj-server
!target/release/lj-ingest
!target/release/hash.txt
!target/site
